# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
pip-wheel-metadata/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
ib-gateway/.env
cp-gateway/.env

# ── Live runtime data (never commit) ──────────────────────────────────────────
quant/active_positions.json
quant/ibkr_uploads.json
quant/journal.json
quant/alerts.json
quant/fortress_config.json
quant/uploads/
quant/backups/
quant/reports/
quant/config_backups/
quant/*.pre-*.json
quant/script_results.json
quant/user_prefs.json

# ── Keep the example config ───────────────────────────────────────────────────
!quant/fortress_config.example.json
!fortress_config.example.json

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── SSH keys (safety net) ─────────────────────────────────────────────────────
*.pem
*.key
id_rsa
id_ed25519
fortress_vps

# ── Node (if any frontend tooling is added) ───────────────────────────────────
node_modules/

# Backup files
*.bak

# Deployed frontend static assets (managed by CI/deploy, not source)
app/static/assets/
app/static/__manus__/
app/static/index.html

# Quant workflow outputs
quant/*.md

# stale backups
*.pre-ibkr-bak
# transient runtime state (regenerated each session)
data/iv_history.json
quant/pending_orders.json
*.pre-sprint0-bak
data/position_snapshots.json
data/entry_conditions.json
