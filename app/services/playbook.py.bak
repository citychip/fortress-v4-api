"""
Post-earnings playbook engine — per Build Spec v1.1 §8.3 and Strategy v3.4 §10.

Implements the gap × IV crush decision matrix plus the high-concentration
override (Strategy §7) and thesis-health checklist gate.
"""

from __future__ import annotations

from dataclasses import dataclass, asdict
from typing import Optional


# Strategy §10 matrix — verdicts before override checks.
# Each band: (gap_low, gap_high, verdict, rule_text, iv_crush_floor)
# iv_crush_floor: minimum IV crush % that converts CONDITIONAL to PROCEED-eligible.
#                 0 means no extra floor (PRIME ENTRY / EVALUATE / PASS).
MATRIX = [
    (-9999, -15.0, "PASS",        "Thesis likely broken at gap < −15%", 0),
    (-15.0,  -8.0, "EVALUATE",    "Evaluate fundamentals before entry (gap −8 to −15%)", 0),
    ( -8.0,  -3.0, "PRIME_ENTRY", "Prime entry zone — proceed assuming thesis intact", 0),
    ( -3.0,   2.0, "CONDITIONAL", "Flat ±2% — buy only if IV crush > 25%", 25.0),
    (  2.0,   5.0, "CONDITIONAL", "Gap +2 to +5% — buy only if IV crush > 30%", 30.0),
    (  5.0, 9999,  "PASS",        "Missed move at gap > +5%, IV will be low", 0),
]

IV_CRUSH_FLOOR_OVERRIDE = 20.0  # Strategy §10: if iv_crush < 20%, force PASS regardless of gap

# High-concentration override (Strategy §7)
HIGH_CONC_THRESHOLD = 50.0
HIGH_CONC_PRIME_LOW = -8.0
HIGH_CONC_PRIME_HIGH = -5.0  # tighter band than standard −3..−8
HIGH_CONC_SIZE_CAP = 1


@dataclass
class ThesisCheck:
    revenue_beat: bool = False
    guidance_maintained: bool = False
    no_leadership_or_regulatory_event: bool = False
    sector_context_normal: bool = False

    @property
    def all_passed(self) -> bool:
        return (
            self.revenue_beat
            and self.guidance_maintained
            and self.no_leadership_or_regulatory_event
            and self.sector_context_normal
        )


def _matrix_lookup(gap_pct: float):
    for low, high, verdict, rule_text, iv_floor in MATRIX:
        if low <= gap_pct < high:
            return verdict, rule_text, iv_floor
    # Defensive: shouldn't reach here given the bands cover everything
    return "PASS", "Out of matrix range", 0.0


def evaluate_post_earnings(
    ticker: str,
    gap_pct: float,
    iv_crush_pct: float,
    concentration_pct: Optional[float] = None,
    thesis: Optional[ThesisCheck] = None,
) -> dict:
    """
    Apply Strategy §10 matrix + §7 concentration override + thesis check.

    Returns a dict ready to JSON-serialize. The verdict field is the matrix
    verdict pre-thesis. final_action is the human-actionable instruction:
    PROCEED only when matrix verdict is PRIME_ENTRY or eligible CONDITIONAL
    AND all four thesis checks pass. Otherwise HOLD/PASS with reasons.
    """
    notes: list[str] = []
    overrides: list[str] = []

    # Override 1: IV crush floor (Strategy §10)
    if iv_crush_pct < IV_CRUSH_FLOOR_OVERRIDE:
        return {
            "ticker": ticker,
            "inputs": {
                "gap_pct": gap_pct,
                "iv_crush_pct": iv_crush_pct,
                "concentration_pct": concentration_pct,
            },
            "verdict": "PASS",
            "verdict_reason": f"IV crush {iv_crush_pct:.1f}% below {IV_CRUSH_FLOOR_OVERRIDE:.0f}% floor — no premium edge.",
            "matrix_band": "iv_crush_override",
            "size_cap": 0,
            "thesis_required": False,
            "thesis_passed": None,
            "final_action": "PASS",
            "notes": notes,
            "overrides_applied": ["iv_crush_floor"],
        }

    verdict, rule_text, iv_floor = _matrix_lookup(gap_pct)

    # Override 2: High concentration (Strategy §7)
    high_conc = concentration_pct is not None and concentration_pct > HIGH_CONC_THRESHOLD
    if high_conc:
        # When name is >50% of book, only PRIME ENTRY band (−5 to −8) qualifies
        # for an add. Other bands force PASS regardless of original verdict.
        if HIGH_CONC_PRIME_LOW <= gap_pct < HIGH_CONC_PRIME_HIGH:
            verdict = "PRIME_ENTRY"
            rule_text = f"High-concentration override: {concentration_pct:.0f}% concentration, gap {gap_pct:+.1f}% in tightened −5..−8% prime band."
            overrides.append("high_concentration_tightened_band")
        elif gap_pct > 5.0:
            verdict = "PROFIT_TRIM"  # Strategy §7: gap-up >5% at >50% conc → profit-trim opportunity
            rule_text = f"High-concentration profit-trim: {concentration_pct:.0f}% concentration, gap +{gap_pct:.1f}% — trim, do not add."
            overrides.append("high_concentration_profit_trim")
        else:
            verdict = "PASS"
            rule_text = f"High-concentration override: {concentration_pct:.0f}% concentration; gap {gap_pct:+.1f}% outside tightened −5..−8% band."
            overrides.append("high_concentration_pass")

    # Apply IV-crush conditional gate
    if verdict == "CONDITIONAL" and iv_floor > 0 and iv_crush_pct < iv_floor:
        verdict_reason = f"{rule_text}. IV crush {iv_crush_pct:.1f}% below required {iv_floor:.0f}%."
        verdict = "PASS"
    else:
        verdict_reason = rule_text

    # Size cap
    size_cap: Optional[int]
    if high_conc and verdict == "PRIME_ENTRY":
        size_cap = HIGH_CONC_SIZE_CAP
    elif verdict in ("PASS", "PROFIT_TRIM"):
        size_cap = 0
    else:
        size_cap = None  # use standard sizing per Strategy §7

    # Thesis check requirement: required for any non-PASS, non-PROFIT_TRIM verdict
    thesis_required = verdict in ("PRIME_ENTRY", "CONDITIONAL", "EVALUATE")
    thesis_passed = None
    final_action = verdict
    if thesis_required:
        if thesis is None:
            final_action = "HOLD"
            notes.append("Thesis health checklist required before PROCEED.")
        else:
            thesis_passed = thesis.all_passed
            if thesis_passed:
                final_action = "PROCEED"
                if verdict == "EVALUATE":
                    notes.append("Thesis confirmed; proceed at reduced size given gap −8..−15%.")
            else:
                final_action = "HOLD"
                missing = [k for k, v in asdict(thesis).items() if not v]
                notes.append(f"Thesis check failed; missing: {', '.join(missing)}.")
    elif verdict == "PASS":
        final_action = "PASS"
    elif verdict == "PROFIT_TRIM":
        final_action = "PROFIT_TRIM"

    return {
        "ticker": ticker,
        "inputs": {
            "gap_pct": gap_pct,
            "iv_crush_pct": iv_crush_pct,
            "concentration_pct": concentration_pct,
        },
        "verdict": verdict,
        "verdict_reason": verdict_reason,
        "matrix_band": _band_label(gap_pct),
        "size_cap": size_cap,
        "thesis_required": thesis_required,
        "thesis_passed": thesis_passed,
        "final_action": final_action,
        "notes": notes,
        "overrides_applied": overrides,
    }


def _band_label(gap_pct: float) -> str:
    """Human label for the matrix band."""
    if gap_pct >= 5.0: return "gap > +5%"
    if gap_pct >= 2.0: return "gap +2..+5%"
    if gap_pct >= -3.0: return "gap ±2..3%"
    if gap_pct >= -8.0: return "gap −3..−8% (PRIME)"
    if gap_pct >= -15.0: return "gap −8..−15%"
    return "gap < −15%"
