<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fortress Dashboard — Portfolio Strategy v3.5</title>
  <link rel="stylesheet" href="/static/style.css">
  <link rel="stylesheet" href="/static/phase4.css">
  <style>
    /* ── Upgraded index.html v3 ── additional layout tokens */

    /* Header bar */
    .header-bar {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 1rem;
    }
    .header-title {
      font-size: 18px; font-weight: 700; letter-spacing: -0.01em;
      margin: 0 0 4px;
    }
    .logo-text {
      font-family: var(--font-mono);
      color: var(--color-text-primary);
      letter-spacing: 0.08em;
    }
    .header-meta {
      display: flex; gap: 16px; align-items: center;
      font-size: 12px; color: var(--color-text-secondary);
    }
    .header-buttons { display: flex; gap: 8px; align-items: center; }

    /* Staleness banner */
    .staleness-banner {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--color-bg-danger); border: 0.5px solid var(--color-border-danger);
      color: var(--color-text-danger);
      padding: 8px 14px; border-radius: var(--radius-md);
      margin-bottom: 12px; font-size: 13px;
    }

    /* Action buttons */
    .action-cta {
      background: var(--color-bg-secondary);
      border: 0.5px solid var(--color-border-secondary);
      border-radius: var(--radius-md);
      padding: 7px 14px; font-size: 13px;
      cursor: pointer; color: var(--color-text-primary);
      transition: background 0.15s;
    }
    .action-cta:hover { background: var(--color-bg-tertiary); }
    .action-cta:disabled { opacity: 0.5; cursor: not-allowed; }
    .action-cta-primary {
      background: var(--color-text-primary); color: var(--color-bg-primary);
      border-color: transparent;
    }
    .action-cta-primary:hover { opacity: 0.85; }
    .action-cta-small {
      padding: 4px 10px; font-size: 12px;
    }
    .phase-stub { opacity: 0.35; cursor: not-allowed; }

    /* Sync indicator */
    .sync-indicator { display: flex; align-items: center; gap: 5px; }
    .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .dot-green  { background: var(--color-border-success); }
    .dot-amber  { background: var(--color-border-warning); }
    .dot-red    { background: var(--color-border-danger); }
    .dot-gray   { background: var(--color-border-secondary); }

    /* Alert state inline */
    .alert-state { display: flex; align-items: center; gap: 5px; font-size: 12px; }

    /* Regime card */
    .regime-card { display: flex; align-items: center; gap: 12px; }
    .regime-circle {
      width: 40px; height: 40px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; font-weight: 700; flex-shrink: 0;
    }
    .regime-bull { background: var(--color-bg-success); color: var(--color-text-success); }
    .regime-bear { background: var(--color-bg-danger); color: var(--color-text-danger); }
    .regime-neutral { background: var(--color-bg-secondary); color: var(--color-text-secondary); }

    /* Pacing */
    .pacing-bar { display: flex; gap: 6px; margin-bottom: 4px; }
    .pacing-slot {
      flex: 1; padding: 6px 8px; border-radius: 6px;
      font-size: 11px; font-weight: 500; text-align: center;
      font-family: var(--font-mono);
    }
    .pacing-filled { background: var(--color-bg-success); color: var(--color-text-success); }
    .pacing-empty  { background: var(--color-bg-secondary); color: var(--color-text-tertiary); border: 1px dashed var(--color-border-tertiary); }

    /* Concentration bar */
    .conc-bar { display: flex; gap: 2px; border-radius: 6px; overflow: hidden; height: 24px; margin-bottom: 4px; }
    .conc-segment { display: flex; align-items: center; padding: 0 6px; font-size: 11px; font-weight: 500; white-space: nowrap; overflow: hidden; }
    .conc-msft  { background: var(--color-bg-danger); color: var(--color-text-danger); }
    .conc-other { background: var(--color-bg-info); color: var(--color-text-info); }
    .conc-third { background: var(--color-bg-secondary); color: var(--color-text-secondary); }

    /* Action items */
    .action-item {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 10px 0;
      border-bottom: 0.5px solid var(--color-border-tertiary);
    }
    .action-item:last-child { border-bottom: none; }
    .action-priority {
      font-size: 10px; font-weight: 700; letter-spacing: 0.06em;
      padding: 3px 7px; border-radius: 4px; flex-shrink: 0; margin-top: 2px;
    }
    .action-prio-HIGH { background: var(--color-bg-danger); color: var(--color-text-danger); }
    .action-prio-MED  { background: var(--color-bg-warning); color: var(--color-text-warning); }
    .action-prio-LOW  { background: var(--color-bg-secondary); color: var(--color-text-secondary); }
    .action-body { flex: 1; min-width: 0; }
    .action-title { font-size: 13px; font-weight: 500; margin: 0 0 2px; }
    .action-desc  { font-size: 12px; color: var(--color-text-secondary); margin: 0; }

    /* Card tight variant */
    .card-tight { padding: 0.75rem 1rem; }

    /* Misc helpers */
    .muted { color: var(--color-text-secondary); }
    .small { font-size: 12px; }
    .loading { color: var(--color-text-tertiary); font-size: 13px; padding: 12px 0; }
    .empty-state { color: var(--color-text-tertiary); font-size: 13px; padding: 8px 0; }
    .error-banner {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--color-bg-danger); border: 0.5px solid var(--color-border-danger);
      color: var(--color-text-danger); padding: 10px 14px;
      border-radius: var(--radius-md); font-size: 13px; gap: 12px;
    }

    /* Ticker tag */
    .ticker-tag {
      display: inline-block; font-family: var(--font-mono); font-size: 12px;
      background: var(--color-bg-secondary); border: 0.5px solid var(--color-border-tertiary);
      border-radius: 4px; padding: 2px 7px; margin: 2px 3px 2px 0;
    }

    /* Journal */
    .journal-entry {
      padding: 10px 0;
      border-bottom: 0.5px solid var(--color-border-tertiary);
    }
    .journal-entry:last-child { border-bottom: none; }
    .journal-meta {
      display: flex; justify-content: space-between; align-items: baseline;
      gap: 8px; margin-bottom: 2px; flex-wrap: wrap;
    }
    .journal-action { font-size: 13px; font-weight: 500; }
    .journal-text { font-size: 12px; color: var(--color-text-secondary); margin: 0; }

    /* Outcomes grid */
    .outcomes-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 12px; }
    .outcome-card {
      background: var(--color-bg-secondary); border-radius: var(--radius-md);
      padding: 12px 14px;
    }
    .outcome-label { font-size: 11px; color: var(--color-text-secondary); margin: 0 0 4px; }
    .outcome-value { font-size: 20px; font-weight: 500; margin: 0; font-variant-numeric: tabular-nums; }
    .outcome-sub { font-size: 11px; color: var(--color-text-tertiary); margin: 2px 0 0; }

    /* Scripts grid */
    .scripts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; margin-bottom: 12px; }
    .script-btn {
      display: flex; flex-direction: column; gap: 2px;
      background: var(--color-bg-secondary); border: 0.5px solid var(--color-border-tertiary);
      border-radius: var(--radius-md); padding: 10px 12px;
      cursor: pointer; text-align: left; font-family: inherit;
      transition: background 0.15s;
    }
    .script-btn:hover { background: var(--color-bg-tertiary); }
    .script-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .script-output {
      background: var(--color-bg-secondary); border-radius: var(--radius-md);
      padding: 12px; font-size: 12px; font-family: var(--font-mono);
      white-space: pre-wrap; max-height: 400px; overflow-y: auto;
    }
    .script-stdout { margin: 4px 0; white-space: pre-wrap; font-size: 12px; }
    .script-stderr { margin: 4px 0; white-space: pre-wrap; font-size: 12px; color: var(--color-text-danger); }

    /* Upload zone */
    .upload-zone {
      border: 2px dashed var(--color-border-secondary);
      border-radius: var(--radius-md); padding: 24px;
      text-align: center; cursor: pointer;
      color: var(--color-text-secondary); font-size: 13px;
      transition: border-color 0.15s, background 0.15s;
    }
    .upload-zone:hover, .upload-zone.drag-over {
      border-color: var(--color-border-info);
      background: var(--color-bg-info);
      color: var(--color-text-info);
    }
    .upload-result { margin-top: 12px; font-size: 13px; }

    /* VIX state tinting */
    .vix-elevated { border-left: 3px solid var(--color-border-warning); }
    .vix-stress    { border-left: 3px solid var(--color-border-danger); }

    /* Responsive */
    @media (max-width: 900px) {
      .row-4 { grid-template-columns: repeat(2, 1fr); }
      .outcomes-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      body { padding: 12px; }
      .row-4, .row-3, .row-2 { grid-template-columns: 1fr; }
      .outcomes-grid { grid-template-columns: 1fr 1fr; }
      .header-bar { flex-direction: column; gap: 8px; }
    }
  </style>
  <link rel="stylesheet" href="/static/settings.css">
</head>
<body>

<div class="dash">

  <!-- Staleness banner (shown when position data > 24h old) -->
  <div id="staleness-banner" class="staleness-banner" style="display: none;">
    <span id="staleness-text">Position state is over 24 hours old.</span>
    <button id="staleness-dismiss" class="action-cta action-cta-small">Dismiss</button>
  </div>

  <!-- Header -->
  <div class="header-bar" id="header-bar">
    <div>
      <p class="header-title">
        <span class="logo-text">FORTRESS</span>
        <span class="muted" style="font-weight:400; font-size:14px;"> — Portfolio Strategy v3.5</span>
      </p>
      <div class="header-meta">
        <span id="header-date">Loading…</span>
        <span id="header-pacing">Pacing: —</span>
        <span class="sync-indicator" id="sync-indicator">
          <span class="dot dot-gray" id="sync-dot"></span>
          <span id="sync-text">Sync: —</span>
        </span>
        <span class="sync-indicator" id="gw-indicator" style="margin-left:8px;" title="IB Gateway status">
          <span class="dot dot-gray" id="gw-header-dot" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#888;vertical-align:middle;"></span>
          <span id="gw-header-text" style="font-size:12px; color:var(--text-muted);">GW: —</span>
        </span>
        <span class="sync-indicator" id="backend-indicator" style="margin-left:8px;" title="Greeks backend">
          <span class="dot dot-gray" id="backend-header-dot" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#888;vertical-align:middle;"></span>
          <span id="backend-header-text" style="font-size:12px; color:var(--text-muted);">Δ: —</span>
        </span>
      </div>
    </div>
    <div class="header-buttons">
      <button class="action-cta" id="refresh-btn">↺ Refresh</button>
      <button class="action-cta action-cta-primary" id="auto-refresh-toggle" data-on="true">Auto: ON</button>
    </div>
  </div>

  <!-- Tab bar -->
  <div class="tabs">
    <button class="tab tab-active" data-tab="briefing">Briefing</button>
    <button class="tab" data-tab="positions">Positions</button>
    <button class="tab" data-tab="manage">Manage</button>
    <button class="tab" data-tab="trade">New trade</button>
    <button class="tab" data-tab="playbook">Playbook</button>
    <button class="tab" data-tab="upload">Uploads</button>
    <button class="tab" data-tab="universe">Universe</button>
    <button class="tab" data-tab="journal">Journal</button>
    <button class="tab tab-btn" data-tab="settings" onclick="navigateToTab(\'settings\')">&#9881; Settings</button>
  </div>

  <!-- ================================================================
       BRIEFING TAB
       ================================================================ -->
  <div class="tab-content tab-content-active" data-content="briefing">
    <div id="briefing-content"><div class="loading">Loading briefing…</div></div>
  </div>

  <!-- ================================================================
       POSITIONS TAB
       ================================================================ -->
  <div class="tab-content" data-content="positions">
    <div class="card">
      <div class="card-header">
        <div>
          <h2>Active book</h2>
          <p class="muted small" id="positions-meta">—</p>
        </div>
        <div class="header-buttons">
          <button class="action-cta" onclick="navigateToTab('upload')">Sync from IBKR ↗</button>
        </div>
      </div>
      <div id="positions-content"><div class="loading">Loading positions…</div></div>
    </div>

    <!-- Active book summary row — rendered by JS when positions load -->
    <div id="positions-summary-row"></div>
  </div>

  <!-- ================================================================
       MANAGE TAB  (Phase 4: stop-loss + roll + scripts)
       ================================================================ -->
  <div class="tab-content" data-content="manage">

    <!-- Settings: Greeks backend -->
    <div class="card">
      <h2>Settings — Greeks backend</h2>
      <p class="muted small">Pick where delta/theta/vega come from. <em>Auto picks the best available
        per the capability check.</em></p>
      <div class="form-row" style="display:flex; flex-wrap:wrap; gap:18px; align-items:flex-start;">
        <label class="radio-label" style="display:flex; align-items:center; gap:6px;">
          <input type="radio" name="greeks-backend" id="gb-auto" value="auto"> Auto
        </label>
        <label class="radio-label" style="display:flex; align-items:center; gap:6px;">
          <input type="radio" name="greeks-backend" id="gb-web" value="web_api"> IBKR Web API + OPRA
        </label>
        <label class="radio-label" style="display:flex; align-items:center; gap:6px;">
          <input type="radio" name="greeks-backend" id="gb-bs" value="bs_yfinance"> Black-Scholes (yfinance)
        </label>
        <label class="radio-label" style="display:flex; align-items:center; gap:6px;">
          <input type="radio" name="greeks-backend" id="gb-tws" value="tws_ibkr"> Legacy TWS (diagnostics)
        </label>
        <button class="action-cta action-cta-small" id="gb-save">Save</button>
        <button class="action-cta action-cta-small" id="gb-recheck">Recheck capability</button>
      </div>
      <div id="gb-status" class="muted small" style="margin-top:8px;">Loading current settings…</div>
      <pre id="gb-capability" style="margin-top:8px; font-size:11px; max-height:240px; overflow:auto; background:var(--bg-card); padding:8px; border-radius:4px; display:none;"></pre>
    </div>

    <!-- Stop-loss aggregator -->
    <div class="card">
      <h2>Stop-loss aggregator</h2>
      <p class="muted small">Strategy v3.5 §6 multi-signal logic — 2 of 3 signals fired = act.
        <em>Sources: yfinance (spot / 200-SMA), latest QuantData Daily Report (DP floors).</em></p>
      <div class="form-row">
        <label>Position
          <select id="stop-loss-position"><option>Loading…</option></select>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" id="stop-loss-fundamental">
          <span>Fundamental break (§6 signal 3)</span>
        </label>
        <label>Peak MV (optional)
          <input type="number" id="stop-loss-peak-mv" step="100" placeholder="—">
        </label>
        <label>Current MV (optional)
          <input type="number" id="stop-loss-current-mv" step="100" placeholder="—">
        </label>
        <button class="action-cta action-cta-primary" id="stop-loss-run">Evaluate</button>
      </div>
      <div id="stop-loss-result" class="phase4-result"></div>
    </div>

    <!-- Roll candidate evaluator -->
    <div class="card">
      <h2>Roll candidate evaluator</h2>
      <p class="muted small">Strategy §5 — short calls only. Default DTE 30–45, delta 0.20–0.25.
        Returns top 3 candidates with IBKR ticket text. <em>Source: yfinance option chain.</em></p>
      <div class="form-row">
        <label>Position
          <select id="roll-position"><option>Loading…</option></select>
        </label>
        <label>DTE band
          <input type="number" id="roll-dte-low"   value="30" min="1"   max="180" style="width:60px"> –
          <input type="number" id="roll-dte-high"  value="45" min="1"   max="365" style="width:60px">
        </label>
        <label>Δ band
          <input type="number" id="roll-delta-low"  value="0.20" step="0.01" min="0.05" max="0.50" style="width:70px"> –
          <input type="number" id="roll-delta-high" value="0.25" step="0.01" min="0.05" max="0.60" style="width:70px">
        </label>
        <button class="action-cta action-cta-primary" id="roll-run">Find candidates</button>
      </div>
      <div id="roll-result" class="phase4-result"></div>
    </div>

    <!-- Run scripts -->
    <div class="card">
      <h2>Run workflow scripts</h2>
      <p class="muted small">Manually trigger any scheduled workflow. Output streams below.</p>
      <div id="scripts-list"><div class="loading">Loading scripts…</div></div>
    </div>

    <!-- ── Price Chart with Dark Pool & GEX overlays ── -->
    <div class="card">
      <h2>Price chart — Dark Pool &amp; GEX overlays</h2>
      <p class="muted small">Candlestick chart with DP Hard Floors (red dashed) and GEX walls (green/orange dashed)
        sourced from the latest QuantData Daily Report.</p>
      <div class="form-row" style="margin-bottom:10px;">
        <label>Ticker
          <select id="chart-ticker-select" onchange="renderChart(this.value, document.getElementById('chart-period-select').value)">
            <option value="">— loading —</option>
          </select>
        </label>
        <label>Period
          <select id="chart-period-select" onchange="renderChart(document.getElementById('chart-ticker-select').value, this.value)">
            <option value="1mo">1 month</option>
            <option value="3mo" selected>3 months</option>
            <option value="6mo">6 months</option>
            <option value="1y">1 year</option>
          </select>
        </label>
        <button class="action-cta" onclick="refreshChartLevels()" style="align-self:flex-end">Refresh levels</button>
      </div>
      <div id="chart-container" style="height:420px;background:#161a1e;border-radius:6px;overflow:hidden;">
        <p class="muted small" style="padding:16px">Select a ticker above to load the chart.</p>
      </div>
    </div>

  </div>




  <!-- ================================================================
       NEW TRADE TAB  (Phase 4: pre-trade checklist)
       ================================================================ -->
  <div class="tab-content" data-content="trade">
    <div class="card">
      <h2>Pre-trade gate check</h2>
      <p class="muted small">Walk through Strategy §8 before submitting an IBKR order.
        Hard gates: earnings blackout (§4), concentration (§7), VIX regime (§7).</p>
      <div id="pretrade-form">
        <div class="form-row">
          <label>Ticker
            <input type="text" id="pt-ticker" placeholder="e.g. AMD" maxlength="5">
          </label>
          <label>Strategy
            <select id="pt-strategy" onchange="showJadeLizardGate()">
              <option value="PMCC">PMCC (LEAP + short call)</option>
              <option value="DIAGONAL">Diagonal</option>
              <option value="PCS">Put credit spread</option>
              <option value="JADE_LIZARD">Jade Lizard</option>
              <option value="SPY_HEDGE">SPY hedge</option>
            </select>
          </label>
          <button class="action-cta action-cta-primary" id="pt-check">Check gates</button>
        </div>
      </div>
      <div id="pretrade-result" class="phase4-result"></div>

      <!-- Jade Lizard credit validation gate — Strategy §2.E -->
      <div id="jade-lizard-gate" style="display:none; margin-top:14px; padding:12px 14px; border-radius:6px; background:var(--bg-card); border:1px solid var(--border);">
        <h3 style="margin:0 0 10px;">Jade Lizard credit validation (§2.E)</h3>
        <p class="muted small">Total credit must exceed call spread width. Enter the structure details:</p>
        <div class="form-row">
          <label>Short put strike<input type="number" id="jl-put-strike" placeholder="450" step="0.5"></label>
          <label>Short call strike<input type="number" id="jl-call-short" placeholder="460" step="0.5"></label>
          <label>Long call strike<input type="number" id="jl-call-long" placeholder="465" step="0.5"></label>
          <label>Put credit ($/share)<input type="number" id="jl-put-credit" placeholder="3.50" step="0.01"></label>
          <label>Call spread credit ($/share)<input type="number" id="jl-call-credit" placeholder="1.20" step="0.01"></label>
          <button class="action-cta action-cta-primary" onclick="validateJadeLizard()">Validate §2.E</button>
        </div>
        <div id="jl-result"></div>
      </div>

    </div>

    <div class="card">
      <h2>Strategy §8 order checklist</h2>
      <ol class="checklist">
        <li>Pull live option chain from IBKR — verify bid/ask spread is tight.</li>
        <li>Pull Clean Decision Chart from TradingView (D timeframe, 50/200 SMA, volume).</li>
        <li>Verify earnings date for the ticker via IR page or WSH.</li>
        <li>Select strikes using real bid/ask/delta + chart structure (not just model output).</li>
        <li>Confirm structure matches intended strategy (PMCC = LEAP + short call, etc.).</li>
        <li>Verify limit price direction (credit vs debit) and magnitude vs mid.</li>
        <li>Submit limit order at mid; walk patiently. After 10:00 ET / 16:00 Amsterdam.</li>
        <li>Log the trade in Journal immediately after fill.</li>
      </ol>
    </div>

    <!-- IV Crush scanner — pulled from /api/candidates -->
    <div class="card">
      <h2>IV Crush scanner</h2>
      <p class="muted small">Sorted by IV/HV spread. Earnings within 10 days are blocked per §4.
        Run <code>iv_crush</code> script to refresh.</p>
      <div id="trade-scanner-table"><div class="loading">Loading candidates…</div></div>
    </div>
  </div>

  <!-- ================================================================
       PLAYBOOK TAB  (Phase 4: post-earnings matrix)
       ================================================================ -->
  <div class="tab-content" data-content="playbook">
    <div class="card">
      <h2>Post-earnings playbook</h2>
      <p class="muted small">Strategy v3.5 §10 matrix + §7 concentration override + thesis-health gate.</p>
      <div class="form-row">
        <label>Ticker
          <input type="text" id="pb-ticker" placeholder="e.g. AMD" maxlength="5">
        </label>
        <label>Gap %
          <input type="number" id="pb-gap" step="0.1" placeholder="-5.2">
        </label>
        <label>IV crush %
          <input type="number" id="pb-iv-crush" step="0.1" min="0" placeholder="28">
        </label>
        <label>Concentration % <span class="muted small">(auto)</span>
          <input type="number" id="pb-concentration" step="0.1" min="0" placeholder="auto">
        </label>
      </div>
      <div class="form-row form-thesis">
        <span class="muted small" style="width:100%">Thesis health checklist (required before PROCEED):</span>
        <label class="checkbox-label"><input type="checkbox" id="pb-revenue"> Revenue beat or in-line</label>
        <label class="checkbox-label"><input type="checkbox" id="pb-guidance"> Guidance maintained or raised</label>
        <label class="checkbox-label"><input type="checkbox" id="pb-leadership"> No CEO/CFO/regulatory event</label>
