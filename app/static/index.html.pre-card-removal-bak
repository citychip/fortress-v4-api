<script>
/* ── Fortress Dashboard v3 — inline enhancements ──
   Extends app.js without replacing it.
   Adds: richer briefing layout, Active Book summary row,
   IV Crush scanner mirrored on New Trade tab,
   and positions summary cards. */

// ─── Briefing: inject candidate scanner into briefing tab ───────────────────
// Override renderBriefing to also embed a compact scanner in the briefing tab
// (the original scanner-card is still rendered by app.js; we just ensure it
//  also appears in the New Trade tab via renderTradeScannerTable below).

// Mirror candidates into the New Trade tab scanner
function renderTradeScannerTable(data) {
  const target = document.getElementById("trade-scanner-table");
  if (!target) return;
  if (!data || !data.rows || data.rows.length === 0) {
    target.innerHTML = '<p class="empty-state">No candidates available. Run iv_crush script to refresh.</p>';
    return;
  }
  const table = document.createElement("table");
  table.innerHTML = `<thead><tr>
    <th>Ticker</th>
    <th class="num">Price</th>
    <th class="num">IVR</th>
    <th class="num">IV/HV</th>
    <th>Earnings</th>
    <th>Conc</th>
    <th>Signal</th>
    <th></th>
  </tr></thead>`;
  const tbody = document.createElement("tbody");
  for (const row of data.rows) {
    const days = row.days_to_earnings;
    const earningsPill = row.earnings_state === "blackout"
      ? `<span class="pill pill-blocked">${days}d ⚠</span>`
      : days != null ? `<span class="pill pill-mute">${days}d</span>`
      : `<span class="pill pill-mute">—</span>`;
    const concPill = row.concentration_state === "high"
      ? `<span class="pill pill-blocked">${row.concentration_pct?.toFixed(0)}% ⚠</span>`
      : row.concentration_state === "moderate"
        ? `<span class="pill pill-info">${row.concentration_pct?.toFixed(0)}%</span>`
        : `<span class="pill pill-mute">—</span>`;
    const signalHtml = signalPillHtml(row.signal);
    const tradeBtn = row.can_trade
      ? `<button class="action-cta" onclick="navigateToTab('trade')">Trade ↗</button>`
      : `<button class="action-cta phase-stub" disabled>—</button>`;
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td class="ticker">${row.ticker}</td>
      <td class="num">$${(row.price ?? 0).toFixed(2)}</td>
      <td class="num">${row.ivr?.toFixed(1) ?? "—"}</td>
      <td class="num ${(row.spread_pp ?? 0) >= 0 ? "pos" : "neg"}">${(row.spread_pp ?? 0) >= 0 ? "+" : ""}${row.spread_pp?.toFixed(1) ?? "—"}pp</td>
      <td>${earningsPill}</td>
      <td>${concPill}</td>
      <td>${signalHtml}</td>
      <td>${tradeBtn}</td>`;
    tbody.appendChild(tr);
  }
  table.appendChild(tbody);
  target.innerHTML = "";
  target.appendChild(table);
}

function signalPillHtml(signal) {
  const map = {
    PRIME_CRUSH:    '<span class="pill pill-prime">prime crush</span>',
    GOOD_SPREAD:    '<span class="pill pill-good">good spread</span>',
    FAIR_SPREAD:    '<span class="pill pill-fair">fair spread</span>',
    POOR_SPREAD:    '<span class="pill pill-mute">poor spread</span>',
    IV_HIGH_HV_HIGH:'<span class="pill pill-caution">iv high · hv high</span>',
    BLOCKED_EARNINGS:'<span class="pill pill-blocked">blocked · earnings</span>',
  };
  return map[signal] || `<span class="pill pill-mute">${signal || "—"}</span>`;
}

// ─── Positions: render summary cards below the table ────────────────────────
function renderPositionsSummary(data) {
  const target = document.getElementById("positions-summary-row");
  if (!target || !data) return;
  target.innerHTML = "";

  const positions = data.positions || [];
  if (positions.length === 0) return;

  // Group by strategy
  const byStrategy = {};
  for (const p of positions) {
    const s = p.strategy || "OTHER";
    byStrategy[s] = (byStrategy[s] || 0) + 1;
  }

  // Alert summary
  const alertCounts = { safe: 0, watch: 0, approaching: 0, breaking: 0, broken: 0, critical_gamma: 0 };
  for (const p of positions) {
    const state = p.alert_state || "safe";
    if (state in alertCounts) alertCounts[state]++;
  }

  const row = document.createElement("div");
  row.className = "row row-3";
  row.style.marginTop = "0";

  // Strategy breakdown card
  const stratCard = document.createElement("div");
  stratCard.className = "card card-tight";
  stratCard.innerHTML = `<h2>Strategy breakdown</h2>`;
  const stratGrid = document.createElement("div");
  stratGrid.style.cssText = "display:flex;flex-wrap:wrap;gap:8px;margin-top:8px";
  for (const [strat, count] of Object.entries(byStrategy)) {
    const tag = document.createElement("div");
    tag.className = "stat";
    tag.style.cssText = "padding:8px 12px;flex:1;min-width:80px";
    tag.innerHTML = `<p class="stat-label">${strat}</p><p class="stat-value" style="font-size:16px">${count}</p>`;
    stratGrid.appendChild(tag);
  }
  stratCard.appendChild(stratGrid);
  row.appendChild(stratCard);

  // Alert state card
  const alertCard = document.createElement("div");
  alertCard.className = "card card-tight";
  alertCard.innerHTML = `<h2>Alert states</h2>`;
  const alertList = document.createElement("div");
  alertList.style.cssText = "display:flex;flex-direction:column;gap:4px;margin-top:8px";
  const alertDefs = [
    { key: "critical_gamma", dot: "dot-red",   label: "Critical gamma" },
    { key: "broken",         dot: "dot-red",   label: "Broken" },
    { key: "breaking",       dot: "dot-red",   label: "Breaking" },
    { key: "approaching",    dot: "dot-amber", label: "Approaching" },
    { key: "watch",          dot: "dot-amber", label: "Watch" },
    { key: "safe",           dot: "dot-green", label: "Safe" },
  ];
  for (const def of alertDefs) {
    const n = alertCounts[def.key] || 0;
    if (n === 0 && def.key !== "safe") continue;
    const item = document.createElement("div");
    item.style.cssText = "display:flex;align-items:center;gap:8px;font-size:13px";
    item.innerHTML = `<span class="dot ${def.dot}"></span><span style="flex:1">${def.label}</span><strong>${n}</strong>`;
    alertList.appendChild(item);
  }
  alertCard.appendChild(alertList);
  row.appendChild(alertCard);

  // Concentration card
  const conc = data.concentration || {};
  const concEntries = Object.entries(conc).sort((a, b) => b[1] - a[1]);
  const concCard = document.createElement("div");
  concCard.className = "card card-tight";
  concCard.innerHTML = `<h2>Concentration by ticker</h2>`;
  if (concEntries.length > 0) {
    const table = document.createElement("table");
    table.innerHTML = `<thead><tr><th>Ticker</th><th class="num">% NetLiq</th><th>Status</th></tr></thead>`;
    const tbody = document.createElement("tbody");
    for (const [ticker, pct] of concEntries.slice(0, 6)) {
      const pill = pct > 50
        ? `<span class="pill pill-blocked">${pct.toFixed(0)}% ⚠</span>`
        : pct > 30
          ? `<span class="pill pill-info">${pct.toFixed(0)}%</span>`
          : `<span class="pill pill-mute">${pct.toFixed(0)}%</span>`;
      const tr = document.createElement("tr");
      tr.innerHTML = `<td class="ticker">${ticker}</td><td class="num">${pct.toFixed(1)}%</td><td>${pill}</td>`;
      tbody.appendChild(tr);
    }
    table.appendChild(tbody);
    concCard.appendChild(table);
  } else {
    concCard.innerHTML += `<p class="empty-state">No concentration data.</p>`;
  }
  row.appendChild(concCard);

  target.appendChild(row);
}

// ─── Portfolio Greeks card in Briefing tab ─────────────────────────────────
// Injected after renderRegimeRow by patching the briefing refresh cycle.
// Reads data.greeks from /api/briefing response.
function renderGreeksCard(greeks) {
  if (!greeks) return null;
  const delta = greeks.portfolio_delta;
  const theta = greeks.portfolio_theta;
  const vega  = greeks.portfolio_vega;
  const bias  = greeks.delta_bias || "neutral";
  const covered = greeks.positions_with_greeks || 0;
  const total   = greeks.positions_total || 0;

  const biasColor = bias === "long" ? "var(--color-text-success)"
                  : bias === "short" ? "var(--color-text-danger)"
                  : "var(--color-text-tertiary)";

  const card = document.createElement("div");
  card.className = "card card-tight";
  card.id = "portfolio-greeks-card";
  card.innerHTML = `
    <h2>Portfolio Greeks</h2>
    <div style="display:flex;flex-direction:column;gap:6px;margin-top:8px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span class="muted small">Net Δ delta</span>
        <span style="font-weight:700;font-size:15px;color:${biasColor}">${delta != null ? delta.toLocaleString(undefined,{signDisplay:'always'}) : '—'}</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span class="muted small">Daily Θ theta</span>
        <span style="font-weight:600;font-size:14px;color:${theta < 0 ? 'var(--color-text-success)' : 'var(--color-text-tertiary)'}">${theta != null ? theta.toLocaleString(undefined,{signDisplay:'always',minimumFractionDigits:2}) : '—'}</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span class="muted small">Vega ν</span>
        <span style="font-weight:600;font-size:14px;color:var(--color-text-tertiary)">${vega != null ? vega.toLocaleString(undefined,{signDisplay:'always',minimumFractionDigits:2}) : '—'}</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--color-border-tertiary);padding-top:6px;margin-top:2px">
        <span class="muted small">Bias</span>
        <span style="font-weight:600;font-size:13px;color:${biasColor};text-transform:capitalize">${bias}</span>
      </div>
      <p class="muted small" style="margin:2px 0 0;text-align:right">${covered}/${total} legs with greeks</p>
    </div>`;
  return card;
}

// ─── Earnings auto-fetch ─────────────────────────────────────────────────────
async function fetchEarningsDates() {
  const btn = document.getElementById("btn-fetch-earnings");
  const resultDiv = document.getElementById("earnings-fetch-result");
  if (btn) { btn.disabled = true; btn.textContent = "Fetching…"; }
  resultDiv.style.display = "none";
  try {
    const res = await fetch("/api/calendar/fetch-earnings", { method: "POST" });
    const data = await res.json();
    if (!res.ok) throw new Error(data.detail || "Fetch failed");
    const added   = (data.added   || []).map(x => `${x.ticker} → ${x.date}`).join(", ") || "none";
    const updated = (data.updated || []).map(x => `${x.ticker} ${x.old_date}→${x.new_date}`).join(", ") || "none";
    resultDiv.innerHTML = `<div class="card card-tight" style="background:var(--color-bg-success);padding:8px 12px">
      <p class="small" style="margin:0"><strong>${data.message}</strong></p>
      <p class="small muted" style="margin:4px 0 0">Added: ${added}</p>
      <p class="small muted" style="margin:2px 0 0">Updated: ${updated}</p>
    </div>`;
    resultDiv.style.display = "block";
    // Refresh the calendar display
    if (typeof renderCalendar === "function") {
      const calData = await apiFetch("/api/calendar");
      renderCalendar(calData);
    }
  } catch (e) {
    resultDiv.innerHTML = `<p class="small" style="color:var(--color-text-danger);margin:0">Error: ${e.message}</p>`;
    resultDiv.style.display = "block";
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = "Auto-fetch from Yahoo ↻"; }
  }
}

// ─── Populate chart ticker dropdown from /api/universe ─────────────────────
async function populateChartTickers() {
  const sel = document.getElementById("chart-ticker-select");
  if (!sel) return;
  try {
    const data = await apiFetch("/api/universe");
    // Combine tier1 + tier2 (exclude macro like SPX/SPY unless desired)
    const tiers = [...(data.tier1 || []), ...(data.tier2 || []), ...(data.macro || [])];
    // Deduplicate and sort
    const tickers = [...new Set(tiers)];
    sel.innerHTML = '<option value="">— select —</option>';
    for (const t of tickers) {
      const opt = document.createElement("option");
      opt.value = t;
      opt.textContent = t;
      sel.appendChild(opt);
    }
  } catch (e) {
    sel.innerHTML = '<option value="">— error loading —</option>';
    console.error("populateChartTickers:", e);
  }
}

// ─── Hook into the existing refreshAll cycle ────────────────────────────────
// Wrap the original refreshAll to also call our new renderers
const _origRefreshAll = window.refreshAll || (() => {});
// We patch after DOMContentLoaded to ensure app.js has defined refreshAll
document.addEventListener("DOMContentLoaded", () => {
  // Populate chart ticker dropdown immediately
  populateChartTickers();
  // Wait one tick for app.js to define refreshAll
  setTimeout(() => {
    const origRefreshAll = window.refreshAll;
    if (typeof origRefreshAll === "function") {
      window.refreshAll = async function () {
        await origRefreshAll();
        // After the main refresh, also populate the trade scanner and positions summary
        const [candidates, positions] = await Promise.all([
          apiFetch("/api/candidates"),
          apiFetch("/api/positions"),
        ]);
        renderTradeScannerTable(candidates);
        renderPositionsSummary(positions);
        // Phase 2 editors
        const [alertsData, journalData, calendarData, briefingData] = await Promise.all([
          apiFetch("/api/alerts"),
          apiFetch("/api/journal"),
          apiFetch("/api/calendar"),
          apiFetch("/api/briefing"),
        ]);
        if (typeof renderAlerts === "function") renderAlerts(alertsData);
        if (typeof renderJournal === "function") renderJournal(journalData);
        if (typeof renderCalendar === "function") renderCalendar(calendarData);
        // Inject Greeks card into briefing tab after renderBriefing has run
        const existingGreeksCard = document.getElementById("portfolio-greeks-card");
        if (existingGreeksCard) existingGreeksCard.remove();
        const greeksCard = renderGreeksCard(briefingData.greeks);
        if (greeksCard) {
          // Insert after the regime row (last card before scanner-card)
          const scannerCard = document.getElementById("scanner-card");
          const briefingContent = document.getElementById("briefing-content");
          if (scannerCard && briefingContent) {
            briefingContent.insertBefore(greeksCard, scannerCard);
          }
        }
      };
    }
  }, 0);
});
</script>
